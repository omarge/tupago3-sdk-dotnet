<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The SDK package must be resolved from the feed produced by `dotnet pack` in CI (repo root /artifacts). -->
    <add key="local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Force TuPago3.Sdk to come ONLY from the locally generated feed (never nuget.org). -->
    <packageSource key="local">
      <package pattern="TuPago3.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
