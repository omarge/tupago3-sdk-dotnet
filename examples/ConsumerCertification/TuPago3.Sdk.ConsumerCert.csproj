<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TuPago3.Sdk.ConsumerCert</RootNamespace>
    <AssemblyName>TuPago3.Sdk.ConsumerCert</AssemblyName>
    <!-- Installs TuPago3.Sdk ONLY from the local NuGet feed generated by the SDK build (see nuget.config). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TuPago3.Sdk" Version="0.1.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
  </ItemGroup>

</Project>
